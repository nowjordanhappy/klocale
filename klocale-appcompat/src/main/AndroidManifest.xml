<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Below Android 13 AppCompat keeps the app's language in memory only unless this says to store it
             (klocale 1.x apps had to add it themselves: Español reopened as English on Android 11). Inert
             from 13, where the system stores it. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
